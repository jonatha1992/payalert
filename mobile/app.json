{
  "expo": {
    "name": "PayAlert",
    "slug": "payalert-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "payalert",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./modules/notification-listener/withNotificationListener",
      [
        "expo-notifications",
        {
          "color": "#1358a8"
        }
      ]
    ],
    "android": {
      "package": "com.tecnofusion.payalert",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "apiBaseUrl": ""
    },
    "platforms": [
      "android"
    ]
  }
}
