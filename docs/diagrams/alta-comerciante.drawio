<mxfile host="app.diagrams.net"><diagram name="Alta de comerciante"><mxGraphModel dx="1600" dy="900" grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Una persona común quiere usar PayAlert: de cero a recibir avisos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=22;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1560" height="46" as="geometry"/></mxCell><mxCell id="c3" value="1. Entra a&#10;payalert-kappa&#10;.vercel.app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="c4" value="2. Toca&#10;«Continuar con Google»&#10;(o email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="c5" value="3. PayAlert revisa si su&#10;correo está en la lista&#10;ALLOWED_SIGNUP_EMAILS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="230" height="100" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="HOY: solo tecnofusion.it@gmail.com&#10;Cualquier otra persona ve&#10;«registro no permitido»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="330" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Si la lista está VACÍA: entra cualquiera&#10;(registro abierto).&#10;Hay que decidirlo antes de vender." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="170" width="330" height="100" as="geometry"/></mxCell><mxCell id="c10" value="no está" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;fontSize=12;fontColor=#dc2626;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="está o lista vacía" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="4. PayAlert le crea&#10;solo su negocio y su&#10;cuenta de dueño" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="100" as="geometry"/></mxCell><mxCell id="c13" value="5. Ve su panel y&#10;vá a «Integraciones»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="230" height="100" as="geometry"/></mxCell><mxCell id="c14" value="6. Toca «Conectar con&#10;Mercado Pago»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="260" height="100" as="geometry"/></mxCell><mxCell id="c15" value="7. Mercado Pago le pide&#10;entrar y tocar «Autorizar»&#10;(no copia ninguna clave)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="260" height="100" as="geometry"/></mxCell><mxCell id="c16" value="8. Vuelve a PayAlert:&#10;«Conectado»&#10;(permiso guardado cifrado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="300" height="100" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="9. Su cliente le paga&#10;(QR, link o transferencia)&#10;en Mercado Pago" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="260" height="100" as="geometry"/></mxCell><mxCell id="c23" value="10. Mercado Pago avisa&#10;a PayAlert del pago" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="260" height="100" as="geometry"/></mxCell><mxCell id="c24" value="11. PayAlert consulta el&#10;monto real con SU permiso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="260" height="100" as="geometry"/></mxCell><mxCell id="c25" value="12. Suena el aviso en su&#10;celular y en la pantalla&#10;del mostrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="260" height="100" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c16" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="A DECIDIR / SIN CONFIRMAR ANTES DE ABRIRLO&#10;- Quién puede registrarse (lista cerrada o abierta).&#10;- Google en modo «Prueba»: solo entran correos de prueba. Hay que publicar la app en Google Cloud.&#10;- Mercado Pago: no confirmado que deje autorizar a cuentas de otros sin revisión previa.&#10;- Ualá no tiene el botón: el comerciante carga los datos de conexión que le da Ualá." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1520" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>