  {
    "kind": "activity",
    "title": "Pago entrante → notificación",
    "lanes": [
      "Proveedor",
      "Webhook API",
      "Worker/Queue",
      "DB/Push"
    ],
    "steps": [
      {
        "id": "s",
        "lane": "Proveedor",
        "text": "Evento pago",
        "type": "start"
      },
      {
        "id": "parse",
        "lane": "Webhook API",
        "text": "Leer y validar",
        "col": 0
      },
      {
        "id": "auth",
        "lane": "Webhook API",
        "text": "Firma/orden válida?",
        "type": "decision",
        "col": 1
      },
      {
        "id": "reject",
        "lane": "Webhook API",
        "text": "Rechazar",
        "col": 2,
        "row": 2
      },
      {
        "id": "enqueue",
        "lane": "Worker/Queue",
        "text": "Dedupe y encolar",
        "col": 2,
        "row": 3
      },
      {
        "id": "ack",
        "lane": "Webhook API",
        "text": "ACK",
        "col": 3,
        "row": 3
      },
      {
        "id": "claim",
        "lane": "Worker/Queue",
        "text": "Claim lote",
        "col": 4,
        "row": 4
      },
      {
        "id": "fetch",
        "lane": "Proveedor",
        "text": "Consultar API",
        "col": 5,
        "row": 5
      },
      {
        "id": "ingest",
        "lane": "DB/Push",
        "text": "Normalizar + ingest",
        "col": 6,
        "row": 6
      },
      {
        "id": "match",
        "lane": "DB/Push",
        "text": "Matching",
        "col": 7,
        "row": 7
      },
      {
        "id": "notify",
        "lane": "DB/Push",
        "text": "Push elegible",
        "col": 8,
        "row": 8
      },
      {
        "id": "done",
        "lane": "Worker/Queue",
        "text": "Marcar DONE",
        "col": 9,
        "row": 9,
        "type": "end"
      }
    ],
    "flows": [
      [
        "s",
        "parse"
      ],
      [
        "parse",
        "auth"
      ],
      [
        "auth",
        "reject",
        "no"
      ],
      [
        "auth",
        "enqueue",
        "si"
      ],
      [
        "enqueue",
        "ack"
      ],
      [
        "ack",
        "claim"
      ],
      [
        "claim",
        "fetch"
      ],
      [
        "fetch",
        "ingest"
      ],
      [
        "ingest",
        "match"
      ],
      [
        "match",
        "notify"
      ],
      [
        "notify",
        "done"
      ]
    ]
  },
