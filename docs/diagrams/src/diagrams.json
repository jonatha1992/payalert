    "ddl": "CREATE TABLE businesses (id UUID PRIMARY KEY, name TEXT); CREATE TABLE users (id UUID PRIMARY KEY, business_id UUID REFERENCES businesses(id), role TEXT); CREATE TABLE stores (id UUID PRIMARY KEY, business_id UUID REFERENCES businesses(id), name TEXT); CREATE TABLE payment_connections (id UUID PRIMARY KEY, business_id UUID REFERENCES businesses(id), store_id UUID REFERENCES stores(id), provider TEXT, status TEXT); CREATE TABLE expected_payments (id UUID PRIMARY KEY, business_id UUID REFERENCES businesses(id), store_id UUID REFERENCES stores(id), amount NUMERIC, currency TEXT, status TEXT, matched_transaction_id UUID); CREATE TABLE transactions (id UUID PRIMARY KEY, business_id UUID REFERENCES businesses(id), connection_id UUID REFERENCES payment_connections(id), expected_payment_id UUID REFERENCES expected_payments(id), amount NUMERIC, status TEXT); CREATE TABLE webhook_events (id UUID PRIMARY KEY, connection_id UUID REFERENCES payment_connections(id), dedupe_key TEXT, status TEXT); CREATE TABLE audit_logs (id UUID PRIMARY KEY, business_id UUID REFERENCES businesses(id), user_id UUID REFERENCES users(id), action TEXT); CREATE TABLE notification_preferences (user_id UUID REFERENCES users(id), business_id UUID REFERENCES businesses(id), push BOOLEAN, email BOOLEAN);"
