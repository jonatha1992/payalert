<mxfile host="app.diagrams.net"><diagram name="Como funciona PayAlert"><mxGraphModel dx="1600" dy="1100" grid="0" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="PayAlert: cómo funciona (2 circuitos distintos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=22;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="A) COBRARLE A TUS CLIENTES por usar PayAlert (tu negocio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;arcSize=3;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1500" height="240" as="geometry"/></mxCell><mxCell id="c4" value="Comerciante&#10;(tu cliente)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ca8a04;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="230" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Paga su plan mensual&#10;PayAlert (Free / Pro)&#10;CUANDO ARMEMOS EL COBRO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Tu cuenta de Mercado Pago&#10;(la tuya, como dueño de PayAlert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="750" y="150" width="280" height="100" as="geometry"/></mxCell><mxCell id="c7" value="Estado: SIN HACER&#10;Solo hay un borrador de planes&#10;(docs/PLANES_SAAS.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="360" height="100" as="geometry"/></mxCell><mxCell id="c8" value="elige plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;strokeWidth=2;fontSize=12;fontColor=#ca8a04;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="te paga" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;strokeWidth=2;fontSize=12;fontColor=#ca8a04;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;fontSize=12;fontColor=#dc2626;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="B) AVISARLE AL COMERCIANTE que le entró un pago (lo que ya construimos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;arcSize=3;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1500" height="640" as="geometry"/></mxCell><mxCell id="c12" value="PASO 1: CONECTAR (una sola vez, 2 toques)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16a34a;strokeColor=#16a34a;fontSize=14;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="410" width="430" height="34" as="geometry"/></mxCell><mxCell id="c13" value="El comerciante toca&#10;«Conectar con&#10;Mercado Pago»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="200" height="90" as="geometry"/></mxCell><mxCell id="c14" value="Autoriza en la página&#10;oficial de Mercado Pago&#10;(no da su clave)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="200" height="90" as="geometry"/></mxCell><mxCell id="c15" value="PayAlert guarda el&#10;permiso cifrado&#10;(se renueva solo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="460" width="230" height="90" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="ESTADO: botón listo en el código&#10;FALTA: tus claves de la app&#10;de Mercado Pago (.env)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="460" width="260" height="90" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;fontSize=12;fontColor=#dc2626;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="PASO 2: CADA VEZ QUE LE ENTRA UN PAGO (automático)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16a34a;strokeColor=#16a34a;fontSize=14;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="430" height="34" as="geometry"/></mxCell><mxCell id="c21" value="Cliente final paga&#10;al comercio&#10;(QR, link o&#10;transferencia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="180" height="100" as="geometry"/></mxCell><mxCell id="c22" value="Mercado Pago&#10;acredita el pago&#10;en la cuenta del&#10;comerciante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="180" height="100" as="geometry"/></mxCell><mxCell id="c23" value="Mercado Pago le&#10;avisa a PayAlert&#10;(IPN / webhook):&#10;«hubo un pago nº X»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="c24" value="PayAlert verifica la&#10;firma y CONSULTA el&#10;pago real: monto,&#10;quién pagó" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="640" width="210" height="100" as="geometry"/></mxCell><mxCell id="c25" value="Guarda el cobro y&#10;lo compara con lo&#10;que el cajero&#10;esperaba" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#16a34a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Aviso en el celular&#10;(notificación push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="600" width="220" height="70" as="geometry"/></mxCell><mxCell id="c31" value="Aviso en pantalla&#10;del mostrador (web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="690" width="220" height="70" as="geometry"/></mxCell><mxCell id="c32" value="Voz: «Llegaron $X»&#10;NO HECHO (la omitimos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="780" width="220" height="70" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c25" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="c25" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#94a3b8;strokeWidth=2;fontSize=12;fontColor=#94a3b8;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.85;entryX=0;entryY=0.2;" edge="1" parent="1" source="c25" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="RESPALDO si el aviso no llega: «Sincronizar»&#10;PayAlert pregunta a Mercado Pago por los pagos nuevos&#10;(PAY-30; dirección de consulta sin confirmar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="430" height="90" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontColor=#d97706;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="c36" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="INCÓGNITA: no está confirmado que Mercado Pago avise de pagos&#10;QR o transferencia directa de una cuenta autorizada.&#10;Se confirma con 1 pago real de prueba." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="870" width="460" height="90" as="geometry"/></mxCell><mxCell id="c39" value="Verde = camino del aviso   |   Azul = lo que ve el comerciante   |   Rojo punteado = pendiente o sin confirmar   |   Amarillo = tu cobro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=12;fontColor=#0f172a;arcSize=8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>